<?xml version="1.0"?>
<launch>
    <arg
        name="robot_name"
        value="sieglinde"/>

    <include file="$(eval find('taurob_moveit_' + arg('robot_name')) + '/launch/planning_context.launch')"/>

    <include file="$(eval find('taurob_moveit_' + arg('robot_name')) + '/launch/move_group.launch')">
        <arg name="publish_monitored_planning_scene" value="true"/>
        <arg name="load_robot_description" value="true"/>
    </include>
</launch>
